# 构建产物
/build/
/build-android/
/out/
*.o
*.a
*.so
*.dll
*.exe
*.dylib

# 分发产物（体积大，由 scripts/package_all.sh 生成并上传到 GitHub Release 附件）
/dist/

# 第三方构建资源（OpenSSL / Wintun / Android SDK / kotlinc，体积大不入库）
# 仅保留说明文档，获取与重建方法见 third_party/README.md
/third_party/*
!/third_party/README.md

# 日志与临时文件
*.log
log.*.txt
/log.txt
crash.log
session.log
*.tmp
*.swp
*~

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 本地配置（含服务器地址、账号等，不入库）
*.local.ini
*.local.json
secrets.*

# 临时抓包 / 调试输出
gre.txt
log.0.txt

# 内部需求文档（不入库）
/项目需求.html

# 本地排版的使用说明（HTML / PDF 不上传）
/使用说明.html
/使用说明.pdf

# 使用说明（内部文档，Markdown / 截图 / HTML / PDF 都不入库）
/docs/images/
/使用说明.md
