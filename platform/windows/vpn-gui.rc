/* vpn-gui.rc - 图标与版本信息（windres 编译） */
#pragma code_page(65001)

#include <windows.h>

#define IDI_APP 101

IDI_APP ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,4,0,0
 PRODUCTVERSION  1,4,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "wwme"
            VALUE "FileDescription",  "VPN 客户端 (SSTP/L2TP/PPTP)"
            VALUE "FileVersion",      "1.3.0.0"
            VALUE "InternalName",     "vpn-gui"
            VALUE "LegalCopyright",   "Copyright (C) 2026 wwm <wwme@163.com>"
            VALUE "OriginalFilename", "vpn-gui.exe"
            VALUE "ProductName",      "VPN 客户端"
            VALUE "ProductVersion",   "1.4.0.0"
            VALUE "Comments",         "作者 wwm  wwme@163.com"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
